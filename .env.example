# --- الزامی ---
# توکن ربات از @BotFather
BOT_TOKEN=
# کلید 9router (هم برای چت، هم برای /v1/search — کلید جدا لازم نیست)
ROUTER_API_KEY=

# --- توصیه‌شده ---
ADMIN_IDS=
API_ID=2040
API_HASH=b18441a1ff607e10a989891a5462e627
ROUTER_BASE_URL=https://9router-production-de60f1f6.up.railway.app/v1
MODEL=fbot
# محلی: ./data/history.db — روی Railway: /data/history.db
DB_PATH=./data/history.db
RESTORE_ON_START=1

# --- بکاپ روی گیت‌هاب (اختیاری) ---
# ریپوی private جدا از ریپوی کد
GITHUB_BACKUP_REPO=
# fine-grained PAT با فقط Contents: Read and write روی همان ریپوی بکاپ
GITHUB_BACKUP_TOKEN=
# رمز AES-GCM؛ گم شود بکاپ‌ها باز نمی‌شوند (openssl rand -base64 24)
BACKUP_PASSPHRASE=
BACKUP_KEEP=14
BACKUP_AUTO_HOURS=24

# --- تنظیم دقیق (اختیاری، پیش‌فرض‌ها خوب‌اند) ---
TOOLS_ENABLED=1
TOOL_MAX_ROUNDS=2
TOOL_TIMEOUT=20
TOOL_MAX_CHARS=24000
